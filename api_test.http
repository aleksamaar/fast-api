# Набор тестов для эндпоинтов, которые можно запускать
# в VSCode с помощью плагина REST Client
# Идентификатор расширения: humao.rest-client


# Создаем продавца
POST http://localhost:8000/api/v1/seller/ HTTP/1.1
Content-Type: application/json

{
    "first_name": "Ivan",
    "last_name": "Petrov",
    "e_mail": "ivan.pet1rov@example.com",
    "password": "12345678"
}

###

# Получаем список всех продавцов
GET http://localhost:8000/api/v1/seller/ HTTP/1.1

###

# Получаем одного продавца по ID
GET http://localhost:8000/api/v1/seller/1 HTTP/1.1

###

# Полностью обновляем данные продавца
PUT http://localhost:8000/api/v1/seller/1 HTTP/1.1
Content-Type: application/json

{
    "id": 1,
    "first_name": "Ivan Updated",
    "last_name": "Petrov Updated",
    "e_mail": "ivan.updated@example.com"
}

###

# Частично обновляем данные продавца
PATCH http://localhost:8000/api/v1/seller/1 HTTP/1.1
Content-Type: application/json

{
    "first_name": "Ivan Patched"
}

###

# Удаляем продавца
# Вместе с ним должны удалиться и его книги
DELETE http://localhost:8000/api/v1/seller/11 HTTP/1.1

###

# Создаем книгу
POST http://localhost:8000/api/v1/books/ HTTP/1.1
Content-Type: application/json

{
    "title": "Call of Cthulhu",
    "author": "Howard P. Lovecraft",
    "count_pages": 923,
    "year": 2020,
    "seller_id": 1
}

###

# Получаем список книг
GET http://localhost:8000/api/v1/books/ HTTP/1.1

###

# Получаем одну книгу по ее ID
GET http://localhost:8000/api/v1/books/4 HTTP/1.1

###

# Полностью обновляем книгу
PUT http://localhost:8000/api/v1/books/3 HTTP/1.1
Content-Type: application/json

{
    "id": 3,
    "title": "Refactoring",
    "author": "Martin Fowler",
    "year": 2026,
    "pages": 450,
    "seller_id": 1
}

###

# Частично обновляем книгу
PATCH http://localhost:8000/api/v1/books/1 HTTP/1.1
Content-Type: application/json

{
    "title": "Refactoring Updated",
    "pages": 470
}

###

# Удаляем книгу
DELETE http://localhost:8000/api/v1/books/1 HTTP/1.1

###

# Проверка ошибки валидации года книги
POST http://localhost:8000/api/v1/books/ HTTP/1.1
Content-Type: application/json

{
    "title": "Old Book",
    "author": "Unknown Author",
    "count_pages": 100,
    "year": 1986,
    "seller_id": 1
}

###

# Проверка получения несуществующей книги
GET http://localhost:8000/api/v1/books/9999 HTTP/1.1

###

# Проверка получения несуществующего продавца
GET http://localhost:8000/api/v1/seller/9999 HTTP/1.1

###

# Проверка удаления несуществующей книги
DELETE http://localhost:8000/api/v1/books/9999 HTTP/1.1

###

# Проверка удаления несуществующего продавца
DELETE http://localhost:8000/api/v1/seller/9999 HTTP/1.1